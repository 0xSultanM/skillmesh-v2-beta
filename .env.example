# Copy to .env and fill in. Every key is optional for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://skillmesh.example.com

# --- AI extraction (Claude). Without credentials, rule-based extraction is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_ENABLED=true
# Strip emails/phones/addresses/profile links before sending text to the LLM
REDACT_PII=true

# --- Resource discovery (optional; curated resources work without these) ---
YOUTUBE_API_KEY=
BRAVE_SEARCH_API_KEY=
# Search live when a skill has no cached resources (results are cached in SQLite)
LIVE_DISCOVERY=true

# --- Limits ---
RATE_LIMIT_PER_MIN=20
SCRAPE_TIMEOUT=10

# --- GitHub analyzer (optional; raises rate limit from 60 to 5000 req/hour) ---
GITHUB_TOKEN=

# "Sign in with GitHub" (create an OAuth App at https://github.com/settings/developers,
# callback URL: http://127.0.0.1:8000/auth/github/callback/). No scopes are requested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain/auth/github/callback/
GITHUB_FREE_ANALYSES=1
DISCOVERY_BUDGET_SECONDS=25

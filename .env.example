# SkillMesh AI - Environment Variables for Vercel Deployment
# Copy this file to .env and fill in your values

# --- Django Core ---
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-project.vercel.app,.vercel.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app,https://*.vercel.app

# --- PostgreSQL Database ---
# Get a free PostgreSQL database from one of these providers:
# - Supabase: https://supabase.com (recommended, free tier available)
# - Neon: https://neon.tech (free tier available)
# - Railway: https://railway.app (free tier available)
# - Aiven: https://aiven.io (free tier available)
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# --- Optional: AI Features ---
# Anthropic API key for AI-powered extraction (optional, falls back to rule-based)
ANTHROPIC_API_KEY=

# --- Optional: Resource Discovery ---
# YouTube Data API key for live video discovery (optional)
YOUTUBE_API_KEY=
# Brave Search API key for article discovery (optional)
BRAVE_SEARCH_API_KEY=

# --- Optional: GitHub Integration ---
# GitHub OAuth App credentials for sign-in (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub personal access token to raise API rate limit (optional)
GITHUB_TOKEN=
# OAuth redirect URI (optional, defaults to /auth/github/callback/)
GITHUB_OAUTH_REDIRECT_URI=
# Free GitHub analyses per visitor before sign-in required (default: 1)
GITHUB_FREE_ANALYSES=1

# --- Optional: Performance ---
# Max seconds for resource discovery (default: 25)
DISCOVERY_BUDGET_SECONDS=25
# Requests per minute per IP (default: 20)
RATE_LIMIT_PER_MIN=20

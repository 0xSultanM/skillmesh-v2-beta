{
  "version": 2,
  "builds": [
    {
      "src": "skillmesh/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    },
    {
      "src": "web/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "skillmesh/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "skillmesh.settings",
    "PYTHONPATH": "."
  }
}
